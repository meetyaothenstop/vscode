# Rebuildable compiler/linker products (Keil, host GCC and IAR)
*.o
*.obj
*.d
*.a
*.lib
*.axf
*.elf
*.hex
*.bin
*.map
*.lnp
*.dep
*.crf
*.lst
*.s51
*.exe
*.dll
*.out
*.build_log.htm
*.htm
*.hex.before
*.axf.before

# IDE machine/UI state; keep .uvprojx/.uvoptx and linker scripts
*.uvguix.*
*.uvgui.*
*.uvmpw
*.bak
*.orig
*.tmp
*.jlink
*.jlink.*
/MDK-ARM/DebugConfig/
/EWARM/Debug/
/EWARM/Release/
/EWARM/settings/
.vscode/
.idea/

# Local tools, video extraction, chat handoffs and generated disassembly
/.superpowers/video-tools/
/.superpowers/conversation-handoff/
/.superpowers/handoff/
**/video-frames/
*disassembly*.txt
**/arm_compare/
**/arm_diagnostic/

# Rebuildable local write-window audit output
/.superpowers/phase-budget/*.disasm
/.superpowers/phase-budget/*.log
/tests/phase_budget_*.log
/.superpowers/low-target/*.log
/.superpowers/main-forward-ovp15/*.log
/.superpowers/main-forward-ovp15/*.disasm
/.superpowers/main-forward-ovp40/*.log
/.superpowers/main-forward-ovp40/*.disasm
/.superpowers/start1a3v/*.log
/.superpowers/start1a3v/*.disasm
/.superpowers/ovp-floor6/*.log
/.superpowers/ovp-floor6/*.disasm
/.superpowers/reverse12/*.log
/.superpowers/reverse12/*.disasm
/.superpowers/reverse-opt1/*.log
/.superpowers/reverse-opt1/*.disasm
/.superpowers/reverse-w128/*.log
/.superpowers/reverse-w128/*.disasm
/.superpowers/reverse-resume/*.log
/.superpowers/reverse-resume/*.disasm

# Do not accidentally commit credentials or local environment files
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
__pycache__/
*.pyc
/.superpowers/multirate/
/.superpowers/fastirq-raw/
/.superpowers/eventdiag/
/.superpowers/oled-frame/
/.superpowers/adcdiag/
/tests/multirate_baseline.log
